<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/colorLinen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivUserAvatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_profile"
            android:padding="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorLinen"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Saive.Circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Huỳnh Thảo Nhi"
                style="@style/TextAppearance.Saive.Header"
                android:textSize="15sp"
                android:textColor="@color/colorNoirBlack" />

            <TextView
                android:id="@+id/tvUserEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="nhi.huynh@saive.com"
                style="@style/TextAppearance.Saive.Light"
                android:textSize="12sp"
                android:textColor="@color/colorSand"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIP CUSTOMER"
                style="@style/TextAppearance.Saive.Label"
                android:textSize="9sp"
                android:textColor="@color/colorMaroon"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnBlockUser"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_beige"
            android:src="@drawable/ic_notify"
            app:tint="@color/colorMaroon" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>