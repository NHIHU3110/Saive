<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorCotton">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorMaroon"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="54dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_trans"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1.0"
                app:tint="@color/colorOnMaroon" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.Saive.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_checkout"
                android:textSize="18sp"
                android:textColor="@color/colorOnMaroon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Address Selector / Saved Address -->
            <LinearLayout
                android:id="@+id/containerAddressSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/TextAppearance.Saive.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/checkout_select_address"
                    android:textColor="@color/colorNoirBlack"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"/>

                <TextView
                    style="@style/TextAppearance.Saive.SubLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/checkout_select_address_desc"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:alpha="0.6"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCheckoutAddresses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_checkout_address"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAddFromCheckout"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:background="@android:color/transparent"
                    android:text="@string/checkout_add_new_address"
                    android:textAllCaps="false"
                    android:textColor="@color/colorMaroon"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorLightGray"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llCountrySelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvCountryLabel"
                    style="@style/TextAppearance.Saive.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_country"
                    android:textSize="12sp"
                    android:alpha="0.6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSelectedCountry"
                    style="@style/TextAppearance.Saive.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_choose_country"
                    android:textSize="22sp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintEnd_toStartOf="@+id/btnCountrySelector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCountryLabel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCountrySelector"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_arrow_right"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/colorOnMaroon"
                    app:cornerRadius="20dp"
                    android:backgroundTint="@color/colorMaroon"
                    app:layout_constraintBottom_toBottomOf="@id/tvSelectedCountry"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvSelectedCountry" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorLightGray"
                android:layout_marginBottom="24dp" />

            <!-- City Selector (Large Header Style) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvCityLabel"
                    style="@style/TextAppearance.Saive.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_city"
                    android:textSize="12sp"
                    android:alpha="0.6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSelectedCity"
                    style="@style/TextAppearance.Saive.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_choose_city"
                    android:textSize="22sp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintEnd_toStartOf="@+id/btnCitySelector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvCityLabel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCitySelector"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_arrow_right"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/colorOnMaroon"
                    app:cornerRadius="20dp"
                    android:backgroundTint="@color/colorMaroon"
                    app:layout_constraintBottom_toBottomOf="@id/tvSelectedCity"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvSelectedCity" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorLightGray"
                android:layout_marginBottom="24dp" />

            <!-- District Selector (Large Header Style) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutDistrict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tvDistrictLabel"
                    style="@style/TextAppearance.Saive.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_district"
                    android:textSize="12sp"
                    android:alpha="0.6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSelectedDistrict"
                    style="@style/TextAppearance.Saive.SectionHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_choose_district"
                    android:textSize="22sp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintEnd_toStartOf="@+id/btnDistrictSelector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDistrictLabel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDistrictSelector"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_arrow_right"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/colorOnMaroon"
                    app:cornerRadius="20dp"
                    android:backgroundTint="@color/colorMaroon"
                    app:layout_constraintBottom_toBottomOf="@id/tvSelectedDistrict"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvSelectedDistrict" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorLightGray"
                android:layout_marginBottom="24dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/sectionTitle"
                style="@style/TextAppearance.Saive.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/checkout_shipping_title"
                android:textColor="@color/colorMaroon"
                android:textSize="14sp"
                android:letterSpacing="0.1" />

            <!-- Shipping Info Container -->
            <LinearLayout
                android:id="@+id/containerShipping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_full_name"
                    app:boxStrokeColor="@color/colorMaroon"
                    app:hintTextColor="@color/colorMaroon"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        style="@style/TextAppearance.Saive.Label" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/label_phone_number"
                    app:boxStrokeColor="@color/colorMaroon"
                    app:hintTextColor="@color/colorMaroon"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        style="@style/TextAppearance.Saive.Label" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/label_email"
                    app:boxStrokeColor="@color/colorMaroon"
                    app:hintTextColor="@color/colorMaroon"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        style="@style/TextAppearance.Saive.Label" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/label_address"
                    app:boxStrokeColor="@color/colorMaroon"
                    app:hintTextColor="@color/colorMaroon"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        style="@style/TextAppearance.Saive.Label" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbSaveInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_save_info"
                    style="@style/TextAppearance.Saive.SubLabel"
                    app:buttonTint="@color/colorMaroon" />

            </LinearLayout>

            <!-- Payment Methods Container (Matches design) -->
            <LinearLayout
                android:id="@+id/containerPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Order Summary Section -->
                <TextView
                    style="@style/TextAppearance.Saive.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/checkout_order_summary"
                    android:textSize="14sp"
                    android:textColor="@color/colorMaroon"
                    android:alpha="0.8" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="32dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/colorLightGray"
                    app:cardBackgroundColor="@color/colorIvory">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvSummaryAddressLabel"
                            style="@style/TextAppearance.Saive.SectionHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/checkout_shipping_to"
                            android:textSize="12sp"
                            android:textColor="@color/colorMaroon"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvSummaryFullName"
                            style="@style/TextAppearance.Saive.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textStyle="bold"
                            android:textColor="@color/colorNoirBlack"
                            tools:text="Thao Nhi Huynh" />

                        <TextView
                            android:id="@+id/tvSummaryAddress"
                            style="@style/TextAppearance.Saive.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:alpha="0.7"
                            android:textColor="@color/colorNoirBlack"
                            tools:text="123 Le Loi Street, District 1, Ho Chi Minh City" />

                        <TextView
                            android:id="@+id/tvSummaryPhone"
                            style="@style/TextAppearance.Saive.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:alpha="0.7"
                            android:textColor="@color/colorNoirBlack"
                            tools:text="+84 901 234 567" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/colorLightGray"
                            android:layout_marginVertical="16dp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                style="@style/TextAppearance.Saive.Label"
                                android:text="@string/label_total"
                                android:textStyle="bold"
                                android:letterSpacing="0.02"
                                android:textColor="@color/colorNoirBlack" />
                            <TextView
                                android:id="@+id/tvSummaryTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                style="@style/TextAppearance.Saive.SectionHeader"
                                android:textColor="@color/colorMaroon"
                                android:textSize="22sp"
                                android:letterSpacing="0.02"
                                tools:text="3.450.000 ₫" />
                        </RelativeLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <RadioGroup
                    android:id="@+id/rgPaymentMethods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Cash Section -->
                    <TextView
                        style="@style/TextAppearance.Saive.Header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_method_cash"
                        android:textSize="14sp"
                        android:textColor="@color/colorMaroon"
                        android:alpha="0.8" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutCod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/colorLightGray"
                        app:cardBackgroundColor="@color/colorIvory"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@mipmap/cashicon" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:text="@string/payment_cod"
                                style="@style/TextAppearance.Saive.Label"
                                android:textColor="@color/colorNoirBlack" />
                            <RadioButton
                                android:id="@+id/rbCod"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:buttonTint="@color/colorMaroon" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Credit & Debit Card Section -->
                    <TextView
                        style="@style/TextAppearance.Saive.Header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_method_card"
                        android:textSize="14sp"
                        android:textColor="@color/colorMaroon"
                        android:alpha="0.8" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutAddCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/colorLightGray"
                        app:cardBackgroundColor="@color/colorIvory">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_plus"
                                app:tint="@color/colorMaroon" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:text="@string/payment_method_add_card"
                                style="@style/TextAppearance.Saive.Label"
                                android:textColor="@color/colorNoirBlack"
                                android:alpha="0.5" />
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_arrow_right"
                                app:tint="@color/colorGrayText" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        style="@style/TextAppearance.Saive.Header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_method_more"
                        android:textSize="14sp"
                        android:textColor="@color/colorMaroon"
                        android:alpha="0.8" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/colorLightGray"
                        app:cardBackgroundColor="@color/colorIvory">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Bank -->
                            <LinearLayout
                                android:id="@+id/layoutBank"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:gravity="center_vertical"
                                android:clickable="true"
                                android:focusable="true">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@mipmap/bankicon" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp"
                                    android:text="@string/payment_bank"
                                    style="@style/TextAppearance.Saive.Label"
                                    android:textColor="@color/colorNoirBlack" />
                                <RadioButton
                                    android:id="@+id/rbBank"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="false"
                                    android:buttonTint="@color/colorMaroon" />
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorLightGray" android:layout_marginHorizontal="16dp"/>

                            <!-- Momo -->
                            <LinearLayout
                                android:id="@+id/layoutMomo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:gravity="center_vertical"
                                android:clickable="true"
                                android:focusable="true">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@mipmap/momoicon" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp"
                                    android:text="@string/payment_momo"
                                    style="@style/TextAppearance.Saive.Label"
                                    android:textColor="@color/colorNoirBlack" />
                                <RadioButton
                                    android:id="@+id/rbMomo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="false"
                                    android:buttonTint="@color/colorMaroon" />
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorLightGray" android:layout_marginHorizontal="16dp"/>

                            <!-- Zalopay -->
                            <LinearLayout
                                android:id="@+id/layoutZaloPay"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:gravity="center_vertical"
                                android:clickable="true"
                                android:focusable="true">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@mipmap/zalopayicon" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp"
                                    android:text="@string/payment_zalopay"
                                    style="@style/TextAppearance.Saive.Label"
                                    android:textColor="@color/colorNoirBlack" />
                                <RadioButton
                                    android:id="@+id/rbZaloPay"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="false"
                                    android:buttonTint="@color/colorMaroon" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </RadioGroup>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Button -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardElevation="24dp"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorMaroon"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAction"
                style="@style/TextAppearance.Saive.Label"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_rounded_white_8dp"
                android:backgroundTint="@color/colorOnMaroonContainer"
                android:text="@string/btn_continue_payment"
                android:textColor="@color/colorOnMaroon"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>