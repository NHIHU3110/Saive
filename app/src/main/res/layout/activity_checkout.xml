<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorCotton">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorMaroon"
        app:liftOnScroll="false"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="54dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_trans"
                android:padding="10dp"
                android:src="@drawable/ic_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/colorOnMaroon" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.Saive.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_checkout"
                android:textSize="18sp"
                android:textColor="@color/colorOnMaroon"
                app:layout_constraintBottom_toBottomOf="@+id/btnBack"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/btnBack" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Default Address Section -->
            <LinearLayout
                android:id="@+id/layoutDefaultAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/TextAppearance.Saive.SectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_shipping_address"
                        android:textColor="@color/colorMaroon"
                        android:textSize="14sp"
                        android:letterSpacing="0.1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnAddAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_add"
                            android:textColor="@color/colorMaroon"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:padding="4dp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/btnChangeAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_change"
                            android:textColor="@color/colorMaroon"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:padding="4dp" />
                    </LinearLayout>
                </RelativeLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/colorMaroon"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvDefaultAddressLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/address_label_home"
                            android:textColor="@color/colorMaroon"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDefaultName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/profile_user_name"
                            android:textColor="@color/colorNoirBlack"
                            android:textStyle="bold"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDefaultAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="347/61 Minh Phung, Quan 11, Ho Chi Minh"
                            android:textColor="@color/colorGrayText"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDefaultPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0366549188"
                            android:textColor="@color/colorGrayText"
                            android:textSize="13sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- New Address Selection Section -->
            <LinearLayout
                android:id="@+id/containerAddressSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView
                        style="@style/TextAppearance.Saive.SectionHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checkout_select_address"
                        android:textColor="@color/colorMaroon"
                        android:textSize="14sp"
                        android:letterSpacing="0.1" />
                    <TextView
                        android:id="@+id/btnAddFromCheckout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/label_add_new_plus"
                        android:textColor="@color/colorMaroon"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:padding="4dp" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCheckoutAddresses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/sectionTitle"
                style="@style/TextAppearance.Saive.SectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/checkout_shipping_title"
                android:textColor="@color/colorMaroon"
                android:textSize="14sp"
                android:letterSpacing="0.1" />

            <!-- Shipping Info Container -->
            <LinearLayout
                android:id="@+id/containerShipping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/label_full_name"
                    app:boxStrokeColor="@color/colorMaroon"
                    app:hintTextColor="@color/colorMaroon"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        style="@style/TextAppearance.Saive.Label" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/label_phone_number"
                    app:boxStrokeColor="@color/colorMaroon"
                    app:hintTextColor="@color/colorMaroon"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        style="@style/TextAppearance.Saive.Label" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/label_email"
                    app:boxStrokeColor="@color/colorMaroon"
                    app:hintTextColor="@color/colorMaroon"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        style="@style/TextAppearance.Saive.Label" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- City Selector -->
                <LinearLayout
                    android:id="@+id/llCitySelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        style="@style/TextAppearance.Saive.SubLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_city"
                        android:textColor="@color/colorGrayText"
                        android:layout_marginBottom="8dp" />

                    <RelativeLayout
                        android:id="@+id/btnCitySelector"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_outline_gray_8dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvSelectedCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:hint="@string/hint_choose_city"
                            android:textColor="@color/colorNoirBlack"
                            style="@style/TextAppearance.Saive.Label" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/colorGrayText" />
                    </RelativeLayout>
                </LinearLayout>

                <!-- District Selector -->
                <LinearLayout
                    android:id="@+id/llDistrictSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        style="@style/TextAppearance.Saive.SubLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_district"
                        android:textColor="@color/colorGrayText"
                        android:layout_marginBottom="8dp" />

                    <RelativeLayout
                        android:id="@+id/btnDistrictSelector"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_outline_gray_8dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvSelectedDistrict"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:hint="@string/hint_choose_district"
                            android:textColor="@color/colorNoirBlack"
                            style="@style/TextAppearance.Saive.Label" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/colorGrayText" />
                    </RelativeLayout>
                </LinearLayout>

                <!-- Ward Selector -->
                <LinearLayout
                    android:id="@+id/llWardSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <TextView
                        style="@style/TextAppearance.Saive.SubLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_ward"
                        android:textColor="@color/colorGrayText"
                        android:layout_marginBottom="8dp" />

                    <RelativeLayout
                        android:id="@+id/btnWardSelector"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_outline_gray_8dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvSelectedWard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:hint="@string/hint_choose_ward"
                            android:textColor="@color/colorNoirBlack"
                            style="@style/TextAppearance.Saive.Label" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/colorGrayText" />
                    </RelativeLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/label_address"
                    app:boxStrokeColor="@color/colorMaroon"
                    app:hintTextColor="@color/colorMaroon"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        style="@style/TextAppearance.Saive.Label" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbSaveInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_save_info"
                    style="@style/TextAppearance.Saive.SubLabel"
                    app:buttonTint="@color/colorMaroon" />

            </LinearLayout>

            <!-- Payment Methods Container (Matches design) -->
            <LinearLayout
                android:id="@+id/containerPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Order Summary Section -->
                <TextView
                    style="@style/TextAppearance.Saive.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/checkout_order_summary"
                    android:textSize="14sp"
                    android:textColor="@color/colorMaroon"
                    android:alpha="0.8" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOrderSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="32dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/colorLightGray"
                    app:cardBackgroundColor="@color/colorIvory"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvSummaryAddressLabel"
                            style="@style/TextAppearance.Saive.SectionHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/checkout_shipping_to"
                            android:textSize="12sp"
                            android:textColor="@color/colorMaroon"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvSummaryFullName"
                            style="@style/TextAppearance.Saive.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textStyle="bold"
                            android:textColor="@color/colorNoirBlack"
                            tools:text="Thao Nhi Huynh" />

                        <TextView
                            android:id="@+id/tvSummaryAddress"
                            style="@style/TextAppearance.Saive.Label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:alpha="0.7"
                            android:textColor="@color/colorNoirBlack"
                            tools:text="123 Le Loi Street, District 1, Ho Chi Minh City" />

                        <TextView
                            android:id="@+id/tvSummaryPhone"
                            style="@style/TextAppearance.Saive.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:alpha="0.7"
                            android:textColor="@color/colorNoirBlack"
                            tools:text="+84 901 234 567" />

                        <TextView
                            android:id="@+id/tvSummarySize"
                            style="@style/TextAppearance.Saive.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:alpha="0.7"
                            android:textColor="@color/colorNoirBlack"
                            tools:text="Size: M" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/colorLightGray"
                            android:layout_marginVertical="16dp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                style="@style/TextAppearance.Saive.Label"
                                android:text="@string/label_total"
                                android:textStyle="bold"
                                android:letterSpacing="0.02"
                                android:textColor="@color/colorNoirBlack" />
                            <TextView
                                android:id="@+id/tvSummaryTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                style="@style/TextAppearance.Saive.SectionHeader"
                                android:textColor="@color/colorMaroon"
                                android:textSize="22sp"
                                android:letterSpacing="0.02"
                                tools:text="3.450.000 ₫" />
                        </RelativeLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Payment Method Section Label Moved Here -->
                <TextView
                    android:id="@+id/tvPaymentMethodLabel"
                    style="@style/TextAppearance.Saive.SectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/checkout_payment_title"
                    android:textSize="18sp"
                    android:textColor="@color/colorNoirBlack"
                    android:layout_marginBottom="16dp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgPaymentMethods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Cash Section -->
                    <TextView
                        style="@style/TextAppearance.Saive.Header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_method_cash"
                        android:textSize="14sp"
                        android:textColor="@color/colorMaroon"
                        android:alpha="0.8" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutCod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/colorLightGray"
                        app:cardBackgroundColor="@color/colorIvory"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@mipmap/cashicon" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:text="@string/payment_cod"
                                style="@style/TextAppearance.Saive.Label"
                                android:textColor="@color/colorNoirBlack" />
                            <RadioButton
                                android:id="@+id/rbCod"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:buttonTint="@color/colorMaroon" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Credit & Debit Card Section -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <TextView
                            style="@style/TextAppearance.Saive.Header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/payment_method_card"
                            android:textSize="14sp"
                            android:textColor="@color/colorMaroon"
                            android:alpha="0.8" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/btnAddPaymentCard"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/btn_add"
                                android:textColor="@color/colorMaroon"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:padding="4dp"
                                android:layout_marginEnd="8dp"/>

                            <TextView
                                android:id="@+id/btnChangePaymentCard"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/btn_change"
                                android:textColor="@color/colorMaroon"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:padding="4dp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutDefaultPaymentCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/colorLightGray"
                        app:cardBackgroundColor="@color/colorIvory"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvDefaultCardNumber"
                                style="@style/TextAppearance.Saive.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:textColor="@color/colorNoirBlack"
                                tools:text="**** **** **** 4242" />

                            <TextView
                                android:id="@+id/tvDefaultCardHolder"
                                style="@style/TextAppearance.Saive.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:alpha="0.7"
                                android:textColor="@color/colorNoirBlack"
                                tools:text="HUYNH THAO NHI" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutAddCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="24dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/colorLightGray"
                        app:cardBackgroundColor="@color/colorIvory"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_plus"
                                app:tint="@color/colorMaroon" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="16dp"
                                android:text="@string/payment_method_add_card"
                                style="@style/TextAppearance.Saive.Label"
                                android:textColor="@color/colorNoirBlack"
                                android:alpha="0.5" />
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_arrow_right"
                                app:tint="@color/colorGrayText" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        style="@style/TextAppearance.Saive.Header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_method_more"
                        android:textSize="14sp"
                        android:textColor="@color/colorMaroon"
                        android:alpha="0.8" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/colorLightGray"
                        app:cardBackgroundColor="@color/colorIvory">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Bank -->
                            <LinearLayout
                                android:id="@+id/layoutBank"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:gravity="center_vertical"
                                android:clickable="true"
                                android:focusable="true">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@mipmap/bankicon" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp"
                                    android:text="@string/payment_bank"
                                    style="@style/TextAppearance.Saive.Label"
                                    android:textColor="@color/colorNoirBlack" />
                                <RadioButton
                                    android:id="@+id/rbBank"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="false"
                                    android:buttonTint="@color/colorMaroon" />
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorLightGray" android:layout_marginHorizontal="16dp"/>

                            <!-- Momo -->
                            <LinearLayout
                                android:id="@+id/layoutMomo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:gravity="center_vertical"
                                android:clickable="true"
                                android:focusable="true">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@mipmap/momoicon" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp"
                                    android:text="@string/payment_momo"
                                    style="@style/TextAppearance.Saive.Label"
                                    android:textColor="@color/colorNoirBlack" />
                                <RadioButton
                                    android:id="@+id/rbMomo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="false"
                                    android:buttonTint="@color/colorMaroon" />
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorLightGray" android:layout_marginHorizontal="16dp"/>

                            <!-- Zalopay -->
                            <LinearLayout
                                android:id="@+id/layoutZaloPay"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:gravity="center_vertical"
                                android:clickable="true"
                                android:focusable="true">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@mipmap/zalopayicon" />
                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp"
                                    android:text="@string/payment_zalopay"
                                    style="@style/TextAppearance.Saive.Label"
                                    android:textColor="@color/colorNoirBlack" />
                                <RadioButton
                                    android:id="@+id/rbZaloPay"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="false"
                                    android:buttonTint="@color/colorMaroon" />
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </RadioGroup>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Button -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardElevation="24dp"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorMaroon"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAction"
                style="@style/TextAppearance.Saive.Label"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_rounded_white_8dp"
                android:backgroundTint="@color/colorOnMaroonContainer"
                android:text="@string/btn_continue_payment"
                android:textColor="@color/colorOnMaroon"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>