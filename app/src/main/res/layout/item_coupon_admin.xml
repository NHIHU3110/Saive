<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/colorLinen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCouponCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAIVE20"
                style="@style/TextAppearance.Saive.Label"
                android:textColor="@color/colorMaroon"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvCouponDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20% OFF on all Silk Collection"
                style="@style/TextAppearance.Saive.Header"
                android:textSize="15sp"
                android:textColor="@color/colorNoirBlack"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvCouponExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expires in 12 days"
                style="@style/TextAppearance.Saive.Light"
                android:textSize="12sp"
                android:textColor="@color/colorSand"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUsageCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="142 Used"
            style="@style/TextAppearance.Saive.Caption"
            android:textSize="10sp"
            android:textColor="@color/colorSand"
            android:background="@drawable/bg_rounded_maroon_btn"
            android:backgroundTint="@color/colorLinen"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>