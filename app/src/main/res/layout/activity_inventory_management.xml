<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorCotton"
    tools:context=".ui.InventoryManagementActivity">

    <!-- Header / Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="54dp"
        android:paddingBottom="20dp"
        android:gravity="center_vertical"
        android:background="@color/colorMaroon"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_white"
            android:elevation="4dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:tint="@color/colorMaroon" />

        <TextView
            style="@style/TextAppearance.Saive.SectionHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:letterSpacing="0.1"
            android:text="@string/admin_inventory_title"
            android:textAllCaps="true"
            android:textColor="@color/colorIvory"
            android:textSize="20sp"
            android:textStyle="italic" />

        <ImageButton
            android:id="@+id/btnAddProduct"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_white"
            android:elevation="4dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_plus"
            app:tint="@color/colorMaroon" />
    </LinearLayout>

    <!-- Search Section -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/colorSand" />

            <EditText
                android:id="@+id/etSearchInventory"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:paddingStart="12dp"
                android:textSize="14sp"
                android:textColor="@color/colorNoirBlack"
                android:textColorHint="@color/colorSand"
                android:fontFamily="sans-serif-light" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Filters / Tabs placeholder -->
    <HorizontalScrollView
        android:id="@+id/filterScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/searchCard">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cat_all"
                android:paddingVertical="10dp"
                android:paddingHorizontal="24dp"
                android:background="@drawable/bg_rounded_black_12dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inventory_low_stock"
                android:paddingVertical="10dp"
                android:paddingHorizontal="24dp"
                android:background="@drawable/bg_material_card"
                android:textColor="@color/colorNoirBlack"
                android:textSize="12sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inventory_out_of_stock"
                android:paddingVertical="10dp"
                android:paddingHorizontal="24dp"
                android:background="@drawable/bg_material_card"
                android:textColor="@color/colorNoirBlack"
                android:textSize="12sp"
                android:fontFamily="sans-serif-light"/>
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInventory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/filterScroll"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>