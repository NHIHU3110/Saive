<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/colorLinen"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left side: Discount/Logo area -->
        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:background="@color/colorMaroon"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvDiscountValue"
                style="@style/TextAppearance.Saive.Thin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20%"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TextAppearance.Saive.Nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/coupon_off"
                android:textColor="@color/white"
                android:alpha="0.8" />
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/colorCotton" />

        <!-- Right side: Details -->
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/white"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCouponTitle"
                style="@style/TextAppearance.Saive.Light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAIVE WELCOME"
                android:textColor="@color/colorNoirBlack"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCouponDesc"
                style="@style/TextAppearance.Saive.Thin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvCouponTitle"
                android:layout_marginTop="4dp"
                android:text="On your first archive access."
                android:textColor="@color/colorSand"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvExpiry"
                style="@style/TextAppearance.Saive.Nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvCouponDesc"
                android:layout_marginTop="12dp"
                android:text="Valid until: Dec 31, 2024"
                android:textColor="@color/colorLinen"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnApply"
                style="@style/TextAppearance.Saive.Nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/tvExpiry"
                android:background="@drawable/bg_cart_variant"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/coupon_copy"
                android:textColor="@color/colorNoirBlack"
                android:textSize="10sp"
                android:textStyle="bold" />

        </RelativeLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>