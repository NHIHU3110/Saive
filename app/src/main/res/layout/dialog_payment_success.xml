<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/colorLightGray"
        android:layout_marginBottom="32dp"/>

    <ImageView
        android:id="@+id/ivSuccess"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@mipmap/paymentsuccesful"
        android:scaleType="centerInside" />

    <TextView
        android:id="@+id/tvSuccessTitle"
        style="@style/TextAppearance.Saive.SectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/payment_success_title"
        android:textSize="18sp"
        android:letterSpacing="0.1"
        android:textColor="@color/colorNoirBlack"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvSuccessDesc"
        style="@style/TextAppearance.Saive.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/payment_success_desc"
        android:textSize="14sp"
        android:alpha="0.6"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinueShopping"
        style="@style/TextAppearance.Saive.Label"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_rounded_maroon_btn"
        android:text="@string/btn_continue_shopping"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnViewOrder"
        style="@style/TextAppearance.Saive.SectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:text="@string/btn_view_order"
        android:textSize="14sp"
        android:textColor="@color/colorMaroon"
        android:letterSpacing="0.1" />

</LinearLayout>