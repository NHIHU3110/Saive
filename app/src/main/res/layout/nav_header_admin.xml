<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:background="@color/colorMaroon"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="32dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@mipmap/model1"
        android:padding="2dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/white"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Saive.Circle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/label_user_role_admin"
        style="@style/TextAppearance.Saive.Header"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_admin_premium_control"
        style="@style/TextAppearance.Saive.Caption"
        android:textColor="@color/colorLinen"
        android:alpha="0.7"
        android:textSize="11sp"
        android:letterSpacing="0.1" />

</LinearLayout>