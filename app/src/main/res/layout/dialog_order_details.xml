<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/colorLinen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvOrderDetailsId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#SA-9012"
            style="@style/TextAppearance.Saive.SectionHeader"
            android:textSize="18sp"
            android:textColor="@color/colorNoirBlack" />

        <TextView
            android:id="@+id/tvOrderDetailsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENDING"
            style="@style/TextAppearance.Saive.Caption"
            android:textColor="@color/colorMaroon"
            android:textSize="10sp"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorLinen"
            android:layout_marginVertical="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_customer"
            style="@style/TextAppearance.Saive.Caption"
            android:textSize="10sp"
            android:textColor="@color/colorSand" />

        <TextView
            android:id="@+id/tvOrderDetailsCustomer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lê Minh Trí"
            style="@style/TextAppearance.Saive.Header"
            android:textSize="16sp"
            android:textColor="@color/colorNoirBlack"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="123 Le Loi, District 1, HCMC"
            style="@style/TextAppearance.Saive.Light"
            android:textSize="13sp"
            android:textColor="@color/colorSand"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_payment_momo_short"
            style="@style/TextAppearance.Saive.Caption"
            android:textSize="10sp"
            android:textColor="@color/colorMaroon"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMarkShipped"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_rounded_maroon_12dp"
                android:text="@string/btn_mark_shipped"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnExportInvoice"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_white_8dp"
                android:text="@string/btn_export_invoice"
                android:textColor="@color/colorNoirBlack"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>