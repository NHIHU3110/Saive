<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorCotton">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorMaroon"
        android:paddingHorizontal="@dimen/spacing_large"
        android:paddingTop="54dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TextAppearance.Saive.SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/address_add_title"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Address Label -->
            <TextView
                style="@style/TextAppearance.Saive.Nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_address_label"
                android:textColor="@color/colorSand"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rounded_maroon"
                    android:backgroundTint="@color/colorMaroon"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"
                    android:text="@string/address_label_home"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipOffice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_rounded_maroon"
                    android:backgroundTint="@color/colorLinen"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"
                    android:text="@string/address_label_office"
                    android:textColor="@color/colorSand"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipOther"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_rounded_maroon"
                    android:backgroundTint="@color/colorLinen"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"
                    android:text="@string/address_label_other"
                    android:textColor="@color/colorSand"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Full Name -->
            <TextView
                style="@style/TextAppearance.Saive.Nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_full_name"
                android:textColor="@color/colorSand"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:hint="@string/hint_full_name"
                android:inputType="textPersonName"
                android:paddingHorizontal="16dp"
                android:textColor="@color/colorNoirBlack"
                android:textSize="14sp" />

            <!-- Phone Number -->
            <TextView
                style="@style/TextAppearance.Saive.Nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_phone_number"
                android:textColor="@color/colorSand"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+84"
                    android:textColor="@color/colorSand"
                    android:textSize="14sp"
                    android:paddingEnd="8dp" />

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="9 số còn lại"
                    android:inputType="phone"
                    android:maxLength="9"
                    android:textColor="@color/colorNoirBlack"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Country Selector -->
            <TextView
                style="@style/TextAppearance.Saive.Nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_country"
                android:textColor="@color/colorSand"
                android:textSize="11sp" />

            <RelativeLayout
                android:id="@+id/btnCountrySelector"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvSelectedCountry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/ivCountryArrow"
                    android:text="@string/hint_choose_country"
                    android:textColor="@color/colorNoirBlack"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivCountryArrow"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/colorSand" />
            </RelativeLayout>

            <!-- City and District -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Saive.Nav"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_city"
                        android:textColor="@color/colorSand"
                        android:textSize="11sp" />

                    <AutoCompleteTextView
                        android:id="@+id/etCity"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_edittext"
                        android:hint="@string/hint_city"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/colorNoirBlack"
                        android:textSize="14sp"
                        android:completionThreshold="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Saive.Nav"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_district"
                        android:textColor="@color/colorSand"
                        android:textSize="11sp" />

                    <AutoCompleteTextView
                        android:id="@+id/etDistrict"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_edittext"
                        android:hint="@string/hint_district"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/colorNoirBlack"
                        android:textSize="14sp"
                        android:completionThreshold="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- Street Address (Now at the end) -->
            <TextView
                style="@style/TextAppearance.Saive.Nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_address"
                android:textColor="@color/colorSand"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etStreet"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext"
                android:gravity="top"
                android:hint="@string/hint_street_address"
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textColor="@color/colorNoirBlack"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cbDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:buttonTint="@color/colorMaroon"
                android:text="@string/address_set_default"
                android:textColor="@color/colorSand"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorMaroon"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveAddress"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_rounded_white_8dp"
            android:backgroundTint="#20FFFFFF"
            android:stateListAnimator="@null"
            android:text="@string/address_save"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>