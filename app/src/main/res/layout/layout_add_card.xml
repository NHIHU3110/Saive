<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/payment_method_add_card"
            android:textColor="@color/colorNoirBlack"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Card Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_card_number"
            android:textColor="@color/colorSand"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1" />

        <EditText
            android:id="@+id/etCardNumber"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_card_number"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:textColor="@color/colorNoirBlack"
            android:textColorHint="#BDBDBD"
            android:importantForAutofill="yes"
            android:autofillHints="creditCardNumber" />

        <!-- Card Holder -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/label_card_holder"
            android:textColor="@color/colorSand"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1" />

        <EditText
            android:id="@+id/etCardHolder"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input_field"
            android:hint="@string/hint_card_holder"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="16dp"
            android:textColor="@color/colorNoirBlack"
            android:textColorHint="#BDBDBD"
            android:importantForAutofill="yes"
            android:autofillHints="name" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Expiry Date -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/label_expiry_date"
                    android:textColor="@color/colorSand"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1" />

                <EditText
                    android:id="@+id/etExpiryDate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_expiry_date"
                    android:inputType="date"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/colorNoirBlack"
                    android:textColorHint="#BDBDBD"
                    android:importantForAutofill="yes"
                    android:autofillHints="creditCardExpirationDate" />
            </LinearLayout>

            <!-- CVV -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/label_cvv"
                    android:textColor="@color/colorSand"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1" />

                <EditText
                    android:id="@+id/etCvv"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="@string/hint_cvv"
                    android:inputType="numberPassword"
                    android:maxLength="3"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/colorNoirBlack"
                    android:textColorHint="#BDBDBD"
                    android:importantForAutofill="yes"
                    android:autofillHints="creditCardSecurityCode" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddCardConfirm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_add_card"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:backgroundTint="@color/colorMaroon"
            app:cornerRadius="8dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
