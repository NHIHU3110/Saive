<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/colorLinen">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_add_voucher"
                style="@style/TextAppearance.Saive.SectionHeader"
                android:textSize="16sp"
                android:textColor="@color/colorNoirBlack"
                android:letterSpacing="0.1" />

            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:background="@color/colorMaroon"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

            <EditText
                android:id="@+id/etVoucherName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="@string/admin_voucher_name"
                android:inputType="text"
                android:importantForAutofill="no"
                android:background="@drawable/bg_rounded_white_8dp"
                android:paddingHorizontal="16dp"
                android:textSize="16sp" />

            <LinearLayout
                android:baselineAligned="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:weightSum="2">
                <EditText
                    android:id="@+id/etVoucherCode"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="8dp"
                    android:hint="@string/admin_voucher_code"
                    android:textAllCaps="true"
                    android:inputType="textCapCharacters"
                    android:importantForAutofill="no"
                    android:background="@drawable/bg_rounded_white_8dp"
                    android:paddingHorizontal="16dp" />
                <EditText
                    android:id="@+id/etVoucherDiscount"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="0.8"
                    android:layout_marginStart="8dp"
                    android:hint="@string/admin_voucher_discount"
                    android:inputType="number"
                    android:importantForAutofill="no"
                    android:background="@drawable/bg_rounded_white_8dp"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etVoucherExpiry"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:hint="@string/admin_voucher_expiry"
                android:focusable="false"
                android:clickable="true"
                android:inputType="datetime"
                android:importantForAutofill="no"
                android:background="@drawable/bg_rounded_white_8dp"
                android:paddingHorizontal="16dp" />

            <EditText
                android:id="@+id/etVoucherDesc"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                android:hint="@string/admin_voucher_desc"
                android:gravity="top"
                android:padding="16dp"
                android:inputType="textMultiLine"
                android:importantForAutofill="no"
                android:background="@drawable/bg_rounded_white_8dp"
                android:fontFamily="sans-serif-light" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveVoucher"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_rounded_black_12dp"
                android:text="@string/admin_save_voucher"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1" />

        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>