        <activity
            android:name=".ui.PaymentSuccessActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CouponActivity"
            android:exported="false" />
        <activity
            android:name=".ui.NotificationDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Saive" />
        <activity
            android:name=".ui.CollectionDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Saive" />
        <activity
            android:name=".ui.CollectionsListActivity"
            android:exported="false"
            android:theme="@style/Theme.Saive" />
        <activity
            android:name=".ui.FlashSaleActivity"
            android:exported="false"
            android:theme="@style/Theme.Saive" />
